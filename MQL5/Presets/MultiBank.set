InpSymbolOverride=
InpStrategyTag=multibank-baseline
InpDistMode=0
InpOffsetFixed=0.95
InpOffsetMin=0.30
InpOffsetMax=3.0
InpSLFixed=1.00
InpArmSides=0
InpPendingMode=1
InpFollowDir=0
InpFollowStep=0.10
InpFollowMinMs=1000
InpFollowMaxPerMin=30
InpPendingLifetimeS=300
InpOcoMode=0
InpStopBuffer=0.02
InpRearmMode=1
InpRearmCooldownS=0
InpRearmSpreadK=1.5
InpExitProfile=2
InpTrailActivation=0.30
InpTrailDistance=0.15
InpTrailStep=0.05
InpLotMode=0
